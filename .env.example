# ============================================================
# ChemAgent 环境配置
# 复制此文件为 .env 并根据实际环境修改
# ============================================================

# === 数据库后端选择 ===
# auth_db_backend: sqlite | postgresql | mysql
CHEM_AUTH_DB_BACKEND=sqlite
CHEM_AUTH_DB_PATH=./data/chemagent_auth.db

# PostgreSQL 连接 (auth_db_backend=postgresql 时生效)
CHEM_POSTGRES_HOST=localhost
CHEM_POSTGRES_PORT=5432
CHEM_POSTGRES_DB=chemagent
CHEM_POSTGRES_USER=chemagent
CHEM_POSTGRES_PASSWORD=chemagent2024
CHEM_POSTGRES_MIN_CONN=2
CHEM_POSTGRES_MAX_CONN=10

# MySQL 连接 (auth_db_backend=mysql 时生效)
CHEM_MYSQL_HOST=localhost
CHEM_MYSQL_PORT=3306
CHEM_MYSQL_DB=chemagent
CHEM_MYSQL_USER=chemagent
CHEM_MYSQL_PASSWORD=chemagent2024
CHEM_MYSQL_MIN_CONN=2
CHEM_MYSQL_MAX_CONN=10

# === Neo4j 图数据库 ===
CHEM_NEO4J_URI=bolt://localhost:7687
CHEM_NEO4J_USER=neo4j
CHEM_NEO4J_PASSWORD=chemagent2024
CHEM_NEO4J_DATABASE=neo4j

# === LLM 配置 (可在管理后台 UI 中配置) ===
# Provider: ollama / lm_studio / openai / azure_openai / deepseek / zhipu / qwen / moonshot / yi / gemini / anthropic / custom_openai
CHEM_LLM_PROVIDER=
CHEM_LLM_BASE_URL=
CHEM_LLM_MODEL=
CHEM_LLM_API_KEY=
CHEM_LLM_MAX_TOKENS=4096
CHEM_LLM_TEMPERATURE=0.7

# === Embedding 配置 ===
# Provider: same_as_llm (复用 LLM 配置) 或同上 Provider 代码
CHEM_EMBEDDING_PROVIDER=
CHEM_EMBEDDING_BASE_URL=
CHEM_EMBEDDING_MODEL=
CHEM_EMBEDDING_API_KEY=
CHEM_EMBEDDING_DIM=768

# Azure OpenAI 专用
CHEM_AZURE_DEPLOYMENT_NAME=
CHEM_AZURE_API_VERSION=2024-02-01

# === API 服务 ===
CHEM_API_HOST=0.0.0.0
CHEM_API_PORT=8000

# === Streamlit ===
CHEM_STREAMLIT_PORT=8501

# === 认证配置 ===
# 本地免登录模式（true 时所有接口跳过 JWT 校验；仅限本地/内网使用，勿暴露公网）
CHEM_AUTH_BYPASS=false
CHEM_JWT_SECRET_KEY=chemagent-dev-secret-change-in-production
CHEM_JWT_ALGORITHM=HS256
CHEM_JWT_ACCESS_EXPIRE_MINUTES=60
CHEM_JWT_REFRESH_EXPIRE_DAYS=7

# === 知识库配置 ===
CHEM_CHROMA_PERSIST_DIR=./data/chromadb
CHEM_CHUNK_SIZE=1000
CHEM_CHUNK_OVERLAP=200
CHEM_RAG_TOP_K=3
CHEM_SIMILARITY_TOP_K=5
CHEM_MAX_FILE_SIZE_MB=10

# === Agent 智能体配置 ===
CHEM_AGENT_ENABLED=true
CHEM_AGENT_MAX_ITERATIONS=10
CHEM_AGENT_TOOL_TIMEOUT=30

# Agent 反思
CHEM_AGENT_REFLECTION_ENABLED=true
CHEM_AGENT_MAX_REFLECTIONS=2

# Agent 记忆
CHEM_AGENT_MEMORY_ENABLED=true
CHEM_AGENT_MEMORY_TOP_K=2
CHEM_AGENT_MEMORY_THRESHOLD=0.75
CHEM_AGENT_MEMORY_MAX_SIZE=200

# Agent 规划
CHEM_AGENT_PLANNING_ENABLED=true

# === 性能优化 ===
CHEM_LLM_TIMEOUT_SECONDS=60
CHEM_CACHE_TTL_SECONDS=60

# === 调试模式 ===
CHEM_DEBUG=false
